cc_prebuilt_library_shared {
    name: "libFaceDetectCA",
    strip: {
        none: true,
    },
    target: {
        android_arm64: { srcs: [ "libs/arm64/libFaceDetectCA.so" ] },
        android_x86_64: { srcs: [ "libs/x86-fake/libFaceDetectCA.so" ] },
    },

    compile_multilib: "64",
    system_ext_specific: true,
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libmegface_ParanoidSense",
    stem: "libmegface",
    strip: {
        none: true,
    },
    target: {
        android_arm64: { srcs: [ "libs/arm64/libmegface.so" ] },
        android_x86_64: { srcs: [ "libs/x86-fake/libmegface.so" ] },
    },

    compile_multilib: "64",
    system_ext_specific: true,
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libMegviiUnlock",
    strip: {
        none: true,
    },
    target: {
        android_arm64: { srcs: [ "libs/arm64/libMegviiUnlock.so" ] },
        android_x86_64: { srcs: [ "libs/x86-fake/libMegviiUnlock.so" ] },
    },

    compile_multilib: "64",
    system_ext_specific: true,
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libMegviiUnlock-jni-1.2",
    strip: {
        none: true,
    },
    target: {
        android_arm64: { srcs: [ "libs/arm64/libMegviiUnlock-jni-1.2.so" ] },
        android_x86_64: { srcs: [ "libs/x86-fake/libMegviiUnlock-jni-1.2.so" ] },
    },

    shared_libs: [
        "libFaceDetectCA",
        "libmegface_ParanoidSense",
        "libMegviiUnlock",
    ],

    compile_multilib: "64",
    check_elf_files: false,
    system_ext_specific: true,
    prefer: true,
}

java_import {
    name: "vendor.aospa.biometrics.face.impl",
    jars: ["libs/arm64/vendorImplPrebuilt.jar"],
    system_ext_specific: true,
    sdk_version: "current",
}

prebuilt_etc {
    name: "default_permissions_co.aospa.sense.xml",
    src: "permissions/default_permissions_co.aospa.sense.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "hiddenapi-whitelist-co.aospa.sense.xml",
    src: "permissions/hiddenapi-whitelist-co.aospa.sense.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp_whitelist_co.aospa.sense.xml",
    src: "permissions/privapp_whitelist_co.aospa.sense.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

android_app {
    name: "ParanoidSense",
    srcs: ["src/**/*.java", "src/**/*.kt"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    certificate: "platform",
    optimize: {
        enabled: false,
    },

    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "setup-wizard-lib",
        "setupcompat",
        "setupdesign",
        "vendor.aospa.biometrics.face",
        "vendor.aospa.biometrics.face.impl",
    ],

    required: [
        "default_permissions_co.aospa.sense.xml",
        "hiddenapi-whitelist-co.aospa.sense.xml",
        "privapp_whitelist_co.aospa.sense.xml",
        "ParanoidSenseOverlay",
    ],

    arch: {
        arm64: {
            jni_libs: [
                "libMegviiUnlock-jni-1.2",
            ],
        },
        x86_64: {
            jni_libs: [
                "libMegviiUnlock-jni-1.2",
            ],
        }
    }

}